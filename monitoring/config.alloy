discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = coalesce(sys.env("COMPOSE_PROJECT"), ".*")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

   rule {
    source_labels = ["service"]
    regex         = "(backend|frontend)-(.+)"
    target_label  = "replica"
    replacement   = "$2"
  }

  rule {
    source_labels = ["service"]
    regex         = "(backend|frontend)-.+"
    target_label  = "service"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.logs.receiver]
}

loki.process "logs" {
  forward_to = [loki.write.grafana.receiver]

  stage.match {
    selector = "{service=\"backend\"}"

    stage.json {
      expressions = {
        level  = "level",
        logger = "logger",
      }
    }

    stage.labels {
      values = {
        level  = "",
        logger = "",
      }
    }
  }

  stage.match {
    selector = "{service=\"frontend\"}"

    stage.drop {
      expression = "\"GET / HTTP/1\\.1\" 200 [0-9]+ \"-\" \"(Wget|Go-http-client/1\\.1)\""
    }
  }
}

loki.write "grafana" {
  external_labels = {
    env = sys.env("DEPLOY_ENV"),
  }

  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_LOKI_TOKEN")
    }
  }
}
