POSTGRES_DB=librarydb
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SECRET_KEY=your_secret_key
DEBUG=True

# --- Monitoring (optional) ---
# Only needed to ship container logs to Grafana Cloud with Alloy:
#   docker compose up -d alloy
# Never commit the token!
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
# Tag for log streams, e.g. local, local-yourname, production
DEPLOY_ENV=local
